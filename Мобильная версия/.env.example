# Copy this file to .env and add your real key.
GEMINI_API_KEY=your_google_ai_api_key

# Optional: default is Nano Banana 2.
# Use gemini-2.5-flash-image if you want the classic Nano Banana model.
GEMINI_IMAGE_MODEL=gemini-3.1-flash-image-preview

# Optional: text model for post generation.
GEMINI_TEXT_MODEL=gemini-2.5-flash
GEMINI_TEXT_FALLBACK_MODELS=gemini-2.5-flash-lite,gemini-3.1-flash-lite

# Optional: model used when web-grounded topic research is explicitly enabled.
GEMINI_SEARCH_TEXT_MODEL=gemini-2.5-flash

# Optional: image fallback if the preview image model is overloaded.
GEMINI_IMAGE_FALLBACK_MODELS=gemini-2.5-flash-image
GEMINI_IMAGE_SIZE=2K

# Optional: high-quality free/limited image router.
AI_IMAGE_PROVIDER_ORDER=gemini,cloudflare,huggingface,qwen,pollinations
IMAGE_PROVIDER_TIMEOUT_MS=90000
GEMINI_IMAGE_DAILY_LIMIT=20
CLOUDFLARE_ACCOUNT_ID=
CLOUDFLARE_API_TOKEN=
CLOUDFLARE_IMAGE_MODEL=@cf/black-forest-labs/flux-1-schnell
CLOUDFLARE_IMAGE_DAILY_LIMIT=40
HUGGINGFACE_API_KEY=
HUGGINGFACE_IMAGE_MODEL=black-forest-labs/FLUX.1-schnell
HUGGINGFACE_IMAGE_DAILY_LIMIT=6
DASHSCOPE_IMAGE_ENABLED=false
DASHSCOPE_API_KEY=
DASHSCOPE_IMAGE_MODEL=qwen-image-2.0-pro
DASHSCOPE_IMAGE_DAILY_LIMIT=10
POLLINATIONS_IMAGE_ENABLED=true
POLLINATIONS_BASE_URL=https://image.pollinations.ai
POLLINATIONS_IMAGE_MODEL=flux
POLLINATIONS_TIMEOUT_MS=60000
POLLINATIONS_RETRY_ATTEMPTS=3
POLLINATIONS_RETRY_DELAY_MS=4500
POLLINATIONS_ENHANCE_PROMPT=false
POLLINATIONS_IMAGE_DAILY_LIMIT=50
POLLINATIONS_API_KEY=
ALLOW_LOCAL_SVG_FALLBACK=false

# Optional: Gemini Google Search grounding for custom topic research.
# Google documents this as a billable tool. In free-only mode it stays disabled even if this flag is changed.
GEMINI_GOOGLE_SEARCH_ENABLED=false

# Optional server port.
PORT=3000

# Free AI API policy
AI_KEYS_POLICY=free-tier-only
AI_FREE_MODELS_ONLY=true
AI_BILLING_ALLOWED=false
AI_PAID_MODELS_ALLOWED=false
AI_PROVIDER_PRIMARY=gemini
AI_PROVIDER_FAST=groq
AI_PROVIDER_TEST=openrouter
GROQ_API_KEY=
OPENROUTER_API_KEY=
OPENROUTER_MODEL=openrouter/free
OPENROUTER_FREE_MODELS_ONLY=true
GEMINI_FREE_TIER_ONLY=true
GROQ_FREE_PLAN_ONLY=true
DISABLE_PAID_AI_TOOLS=true
